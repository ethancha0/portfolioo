# Umami Cloud: https://cloud.umami.is
# 1. Create a website, copy its Website ID
# 2. Paste the ID below, then add the same vars in your host (Vercel, etc.)

NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: only needed for self-hosted Umami
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Optional: comma-separated production hostnames (skips other hosts)
# NEXT_PUBLIC_UMAMI_DOMAINS=yourdomain.com,www.yourdomain.com
# Optional: send events from localhost during development
# NEXT_PUBLIC_UMAMI_TRACK_LOCAL=true
